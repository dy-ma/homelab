{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/homelab-logo.txt",
    "padding": {
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 10
    },
    "percent": {
      "type": 9
    }
  },
  "modules": [
    {
      "type": "title",
      "keyColor": "blue"
    },
    "separator",
    {
      "type": "os",
      "key": "OS",
      "keyColor": "blue"
    },
    {
      "type": "uptime",
      "key": "Uptime",
      "keyColor": "blue"
    },
    {
      "type": "loadavg",
      "key": "Load",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "Memory",
      "keyColor": "blue"
    },
    {
      "type": "disk",
      "key": "Disk",
      "keyColor": "blue",
      "folders": "/"
    },
    {
      "type": "localip",
      "key": "LAN",
      "keyColor": "blue",
      "showIpv6": false,
      "showMac": false
    },
    {
      "type": "command",
      "key": "Alerts",
      "keyColor": "yellow",
      "text": "~/.local/bin/homelab-status"
    }
  ]
}
