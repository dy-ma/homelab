# When connected remotely, print GitHub CLI browser URLs instead of opening
# them in the remote Mac's graphical session.
if [[ -n "$SSH_CONNECTION" ]]; then
  export GH_BROWSER=echo
fi

# Interactive history shared across terminal sessions.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY SHARE_HISTORY HIST_IGNORE_DUPS HIST_REDUCE_BLANKS

# Portable navigation and listing helpers.
export CLICOLOR=1
export LSCOLORS='GxFxCxDxCxExExBxBxDxDx'

alias ls='ls -G'
alias ll='ls -lh'
alias la='ls -lah'

cl() {
  builtin cd -- "$@" && command ls -G
}

# Install a Homebrew package and record it in the homelab Brewfile. Pass
# --cask for graphical applications.
brewadd() {
  brew install "$@" && brew bundle add \
    --file="${HOMELAB_REPO:-$HOME/homelab}/Brewfile" \
    --no-describe \
    "$@"
}

# Native Zsh completion.
autoload -Uz compinit
compinit

# Prompt and interactive assistance installed through Homebrew.
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

if command -v brew >/dev/null 2>&1; then
  _homelab_brew_prefix="$(brew --prefix)"

  if [[ -r "$_homelab_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
    source "$_homelab_brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
  fi

  # Syntax highlighting must be sourced after other interactive shell plugins.
  if [[ -r "$_homelab_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
    source "$_homelab_brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  fi

  unset _homelab_brew_prefix
fi

# Show the homelab dashboard once per top-level interactive session. Child
# shells inherit the guard and do not redraw it.
if [[ -t 1 && "$TERM" != dumb && -z "$HOMELAB_FETCH_SHOWN" ]] && command -v fastfetch >/dev/null 2>&1; then
  export HOMELAB_FETCH_SHOWN=1
  fastfetch
fi
